# --- Twilio (telephony + dual-channel call recording) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The one number all test calls originate from (E.164). This is the number
# reported in the submission form -- never dial from anything else.
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# The assessment test line. Hardcoded default lives in config.py; override only
# if Pretty Good AI publishes a different number.
TARGET_NUMBER=+18054398008

# Publicly reachable base URL for the media-stream websocket (ngrok / cloudflared).
# Example: https://abc123.ngrok.app
PUBLIC_BASE_URL=

# --- Speech (one Deepgram key covers both directions) ---
# STT: nova-3 transcribes the agent's side. TTS: Aura-2 speaks as the patient.
DEEPGRAM_API_KEY=

# --- Patient brain + bug judge ---
ANTHROPIC_API_KEY=

# --- Optional TTS upgrade ---
# TTS_PROVIDER=elevenlabs        # default is deepgram (Aura-2)
# ELEVENLABS_API_KEY=            # required only when TTS_PROVIDER=elevenlabs
# TTS_VOICE=                     # provider-specific voice override
